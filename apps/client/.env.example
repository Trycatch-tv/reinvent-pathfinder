# Configuración del cliente Pathfinder (Vite). Copia este archivo a `.env` y ajusta.
# Solo variables con prefijo VITE_ se exponen al navegador.

# ID del evento de AWS Events contra el que se consulta disponibilidad/agenda live.
# Sin este valor, el cliente funciona en modo fixture local y el botón
# "Actualizar disponibilidad" permanece deshabilitado.
VITE_AWS_EVENT_ID=reinvent2026

# (Opcional) URI de callback OAuth 2.0 + PKCE para AWS Builder ID.
# Si se omite, se deriva de window.location.origin + "/callback".
# VITE_AUTH_REDIRECT_URI=http://localhost:8484/callback
