# ==============================================================================
# re:Invent Pathfinder — Configuración de Variables de Entorno (Vite)
# ==============================================================================
# Copia este archivo a `.env` o `.env.local` y ajusta según tu entorno de ejecución.
# Solo las variables con prefijo `VITE_` son expuestas al bundle web del cliente.
#
# MATRIZ DE CAPACIDADES POR ENTORNO:
# ------------------------------------------------------------------------------
# 1. Desarrollo Local (Modo Demo):
#    - Sin configuración necesaria; opera 100% offline y local-first.
#    - Catálogo normalizado demo, heurísticas locales, persistencia en localStorage.
#
# 2. Desarrollo Local (Modo Live con AWS Events):
#    - Requiere credenciales de AWS Builder ID para OAuth 2.0 PKCE.
#    - Las llamadas a AWS Events se proxifican a través de Vite (`/aws-events/v1`).
#    - Requiere `VITE_AWS_EVENT_ID` configurado.
#
# 3. Despliegue Estático Público / Preview (Netlify / Vercel):
#    - Modo Demo disponible para cualquier visitante sin credenciales.
#    - Modo Live disponible para usuarios con AWS Builder ID registrado en el evento.
#    - Requiere `VITE_AUTH_REDIRECT_URI` apuntando al dominio público de callback.
# ==============================================================================

# Identificador oficial del evento en la API de AWS Events.
# Valor estándar de re:Invent: `reinvent2026` o `reinvent-2026`
VITE_AWS_EVENT_ID=reinvent-2026

# URI de redirección registrada para el flujo OAuth 2.0 PKCE con AWS Builder ID.
# Si se omite, se deriva automáticamente de: window.location.origin + "/callback"
# Ejemplo local: http://localhost:8484/callback
# Ejemplo producción: https://charlasreinvent.netlify.app/callback
VITE_AUTH_REDIRECT_URI=http://localhost:8484/callback

# Modelo de inferencia de Amazon Bedrock utilizado para análisis y re-ranking en modo Live
# Valores recomendados: amazon.nova-lite-v1:0 | anthropic.claude-3-5-sonnet-20241022-v2:0
VITE_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
